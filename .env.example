# --- Required ---
API_ID=
API_HASH=
SESSION_STRING=           # from: python make_session.py
API_KEY=                  # MetaAPI token
ACCOUNT_ID=               # MetaAPI account id

# --- Which groups to trade (strongly recommended) ---
SIGNAL_CHATS=             # e.g. -1001234567890,-1009876543210   (from: python list_chats.py)
NOTIFY_CHAT=me            # reports + /commands go to your Saved Messages

# --- Safety first: run like this on a DEMO account before going live ---
DRY_RUN=true

# --- Sizing (pick one) ---
LOT_SIZE=0.01             # lots per TP leg
RISK_PERCENT=0            # e.g. 1 = risk 1% of balance per signal, overrides LOT_SIZE
MAX_LOT_PER_SIGNAL=1.0
MAX_TPS=3

# --- Limits ---
MAX_OPEN_SIGNALS=3
MAX_DAILY_LOSS_PERCENT=5
ALLOWED_SYMBOLS=XAUUSD
MARKET_TOLERANCE_PIPS=20
PENDING_EXPIRY_MIN=240

# --- Staged SL ---
BE_BUFFER_PIPS=5          # TP1 hit -> SL to entry + 5 pips (gold pip = 0.10, so +0.50)

# --- Broker symbol names (if your broker uses e.g. XAUUSD.m or GOLD) ---
SYMBOL_SUFFIX=
SYMBOL_MAP=               # e.g. {"XAUUSD": "GOLD"}

# --- Railway: add a Volume mounted at /data so the trade log survives redeploys ---
DB_PATH=/data/trades.db
