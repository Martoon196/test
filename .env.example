# --- Required ---
API_ID=
API_HASH=
SESSION_STRING=           # from: python make_session.py
API_KEY=                  # MetaAPI token
ACCOUNT_ID=               # MetaAPI account id (or use ACCOUNTS below for several)

# --- Which groups to trade (strongly recommended) ---
SIGNAL_CHATS=             # e.g. -1001234567890,-1009876543210   (from: python list_chats.py)
NOTIFY_CHAT=me            # reports + /commands go to your Saved Messages
SHADOW_MODE=true          # follow EVERY group's signals on live prices (no trading) -> /scorecard ranks them

# --- Safety first: run like this on a DEMO account before going live ---
DRY_RUN=true
CONNECTION_MODE=rpc       # switch to "streaming" once the demo run is stable: ~1 s reaction instead of 10 s

# --- Several accounts (own + prop firm): the same signals go to all of them. Leave empty for just ACCOUNT_ID.
# ACCOUNTS=[{"id":"<metaapi id>","name":"own"},{"id":"<metaapi id>","name":"FTMO 100k","lot_multiplier":5,"max_daily_loss_percent":4,"kill_switch_loss_percent":4.5}]

# --- Sizing (pick one) ---
LOT_SIZE=0.01             # lots per TP leg
RISK_PERCENT=0            # e.g. 1 = risk 1% of balance per signal, overrides LOT_SIZE
MAX_LOT_PER_SIGNAL=1.0
MAX_TPS=3

# --- Limits ---
MAX_OPEN_SIGNALS=3
MAX_DAILY_LOSS_PERCENT=5  # stop opening new trades when equity is this far below the day's start
KILL_SWITCH_LOSS_PERCENT=10   # close everything + pause at this much. /resume clears it. 0 = off
MAX_SPREAD_PIPS=8         # don't enter gold while the spread is wider than this (news). 0 = off
SPREAD_WAIT_SEC=60        # wait up to this long for the spread to settle before skipping the signal
ALLOWED_SYMBOLS=XAUUSD
MARKET_TOLERANCE_PIPS=20
PENDING_EXPIRY_MIN=240

# --- Signal filters (all off by default - run backtest.py with --hours/--min-rr/--max-sl-pips to see which pay) ---
TRADING_HOURS_UTC=        # e.g. 07:00-20:00 (London open to NY close)
TRADING_DAYS=mon-fri
MIN_RR=0                  # e.g. 1 = average TP distance must be at least the stop distance
MAX_SL_PIPS=0             # e.g. 150 = skip gold signals with a stop wider than 150 pips ($15)
MIN_SL_PIPS=0
SKIP_IF_TP1_PASSED=true   # late signal, price already through TP1 -> don't chase it
DUPLICATE_WINDOW_MIN=240  # a group re-posting the same trade within 4 h is skipped
MAX_OPEN_PER_SYMBOL_DIRECTION=1   # three groups saying "buy gold" = ONE position, not three. 0 = off
TIME_STOP_HOURS=0         # close whatever is still open after this many hours. 0 = off

# --- Per-group overrides (optional; /group <id> ... changes these at runtime without a redeploy) ---
# GROUP_SETTINGS={"-1001234567890": {"enabled": false}, "Gold Kings": {"lot_size": 0.02, "max_tps": 2, "be_buffer_pips": 10, "time_stop_hours": 12}}

# --- Staged SL ---
BE_BUFFER_PIPS=5          # TP1 hit -> SL to entry + 5 pips (gold pip = 0.10, so +0.50)

# --- Reports (UTC) ---
DAILY_SUMMARY_HOUR_UTC=21 # -1 = off
WEEKLY_REPORT_DAY=mon     # the database backup is sent with it. "" = off
WEEKLY_REPORT_HOUR_UTC=7
FORM_WINDOW=20            # "recent form" = a group's last 20 finished shadow trades
AUTO_DISABLE=true         # switch a traded group off when its form is bad...
AUTO_DISABLE_MIN_TRADES=20
AUTO_DISABLE_BELOW_R=-0.15   # ...avg below -0.15R over the window. /group <id> on re-enables it

# --- Watchdog ---
WATCHDOG_MIN=5            # ping Telegram + MetaAPI every 5 min, reconnect and tell you if they fail
HEARTBEAT_URL=            # optional dead-man's switch: a healthchecks.io ping URL - alerts you if the bot dies
HEARTBEAT_MIN=5

# --- Dashboard: web page with equity curve, open trades, scorecard ---
# Set a long random token to enable. On Railway: Settings -> Networking -> Generate Domain, then open
# https://<your-domain>/?token=<DASHBOARD_TOKEN>  (the bot messages you the link at start-up)
DASHBOARD_TOKEN=

# --- Broker symbol names (if your broker uses e.g. XAUUSD.m or GOLD) ---
SYMBOL_SUFFIX=
SYMBOL_MAP=               # e.g. {"XAUUSD": "GOLD"}

# --- Railway: add a Volume mounted at /data so the trade log survives redeploys ---
DB_PATH=/data/trades.db
